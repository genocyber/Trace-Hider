{
  "manifest_version": 3,
  "name": "Trace Hider",
  "version": "1.2.1",
  "description": "Registro privado y persistente con acceso protegido...",
  "author": "José",
  "icons": {
    "48": "assets/icon.png"
  },
  "background": {
    "scripts": ["src/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "omnibox": {
    "keyword": "secreto"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Abrir Trace Hider"
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "webNavigation",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}